# Anthropic API key (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Free LLM Providers (No credit card required):
# Groq Free API Key (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Free API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Note: If no API key is provided, the system automatically falls back to Mock Mode
# (rule-based agent evaluating live DB signals for 100% free hosting).

# Postgres for local Docker Compose; falls back to sqlite:///./dev.db if unset for quick local runs
DATABASE_URL=postgresql://fraud:fraud@localhost:5432/fraud_investigations

# Risk score (0-1) above which a transaction is handed to the Investigation Agent
RISK_THRESHOLD=0.7

# FastAPI backend base URL, used by the /web frontend
API_BASE_URL=http://localhost:8000
